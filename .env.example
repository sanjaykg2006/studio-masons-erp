# Studio-Masons ERP — environment template.
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
#
# Find these in your Supabase dashboard:
#   Project Settings -> Data API (or API) -> Project URL + anon/public key.

# --- Public (safe in the browser) -------------------------------------------
# The anon key is public by design; Row-Level Security protects your data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Canonical public origin for auth redirect links (invite / magic link). Falls
# back to the incoming request host if unset. In dev: http://localhost:3000.
# In production set it to your deployed URL (e.g. https://your-app.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secret (NEVER expose to the browser) -----------------------
# The service_role key bypasses Row-Level Security. Used only by gated server
# actions (e.g. inviting/removing users). Do NOT prefix it with NEXT_PUBLIC_.
# In production, set this in your host's env vars (e.g. Vercel), not in code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
