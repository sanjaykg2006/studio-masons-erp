# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase cli (local link state, temp files — never commit)
supabase/.temp
supabase/.branches

# database backups — contain real data, keep OFF git; store them elsewhere
/backups

# personal project tracker (living local file, not source)
ERP-Project-Tracker.xlsx
# Excel lock/temp files
~$*

# local Claude Code settings
.claude/settings.local.json

# reference docs / spreadsheets dropped at repo root — not source, keep OFF git
/*.docx
/*.xlsx
/*.xls
/*.csv

# old parser — dead code kept locally for reference
/Old Parser/

# old finance module — kept locally for reference, not source
/Old - Finance Module Files/

# old procurement module — reference source for the ported PO generator, not built
/Old - Procurement/

# local working notes / drafts — not source
/docs/finance-module-questions.md
/docs/inventory-management-guide.md

# internal review / remediation / leadership reports — keep OFF git (not source)
/ERP-Remediation-Plan.txt
/ERP-Review-Report.txt
/docs/director-report-2026-06-30.md
/ERP-Self-Hosting-Roadmap.docx

# typescript
*.tsbuildinfo
next-env.d.ts
